# =============================================================================
# MeowFlow Local Environment Variables Template (REAL environment, no mock)
# =============================================================================
# 使用方式:
#   1) 复制本文件为 .env.local    cp .env.example .env.local
#   2) 填入你持有的真实 API key / webhook
#   3) 启动前加载                  docker compose --env-file .env.local -f docker-compose.dev.yml up -d
#   4) 本地跑应用时同样加载         set -a; source .env.local; set +a && mvn spring-boot:run
#      或在 IDEA Run Configuration 的 Environment variables 中粘贴
#
# 留空 = 关闭该提供方（ChatClientFactory 不会注册对应 provider）
# =============================================================================


# ==========================================
# === 基础设施 (本地 Docker Compose)     ===
# ==========================================
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_DB=meowflow
POSTGRES_USER=meowflow
POSTGRES_PASSWORD=meowflow123

REDIS_HOST=localhost
REDIS_PORT=6379

RABBITMQ_HOST=localhost
RABBITMQ_PORT=5672
RABBITMQ_USER=guest
RABBITMQ_PASSWORD=guest

MINIO_ENDPOINT=localhost:9000
MINIO_ACCESS_KEY=minioadmin
MINIO_SECRET_KEY=minioadmin
MINIO_BUCKET=meowflow-files

NACOS_HOST=localhost
NACOS_PORT=8848
NACOS_NAMESPACE=public
NACOS_GROUP=DEFAULT_GROUP
NACOS_ENABLED=true
NACOS_CONFIG_ENABLED=false
SENTINEL_DASHBOARD=localhost:8858

# ==========================================
# === App 通用                          ===
# ==========================================
SPRING_PROFILES_ACTIVE=dev
CRYPTO_AES_KEY=dGhpcyBpcyBhIDMyLWJ5dGUga2V5ISEh
SNOWFLAKE_WORKER_ID=0
SNOWFLAKE_DATACENTER_ID=0


# =============================================================================
# === AI / LLM Providers (缺失时 ChatClientController 无法调用真实对话)   ===
# =============================================================================
# 至少配置其中一个，下方 ChatClientFactory.init() 才会注册对应 client。

# --- OpenAI ---------------------------------------------------------------
#  官方: https://platform.openai.com/api-keys
#  本地替代 (Ollama / vLLM):
#    OPENAI_API_KEY=ollama
#    meowflow.infra.chat.openai.base-url=http://host.docker.internal:11434/v1
#    meowflow.infra.chat.openai.model=qwen2.5:7b
OPENAI_API_KEY=
meowflow.infra.chat.openai.api-key=${OPENAI_API_KEY:}
meowflow.infra.chat.openai.base-url=https://api.openai.com/v1
meowflow.infra.chat.openai.model=gpt-4o-mini

# --- Anthropic Claude -----------------------------------------------------
ANTHROPIC_API_KEY=
meowflow.infra.chat.anthropic.api-key=${ANTHROPIC_API_KEY:}
meowflow.infra.chat.anthropic.base-url=https://api.anthropic.com
meowflow.infra.chat.anthropic.model=claude-3-5-sonnet-20240620

# --- 阿里通义 (DashScope) -------------------------------------------------
#  控制台: https://dashscope.console.aliyun.com/apiKey
meowflow.infra.chat.ali.api-key=
meowflow.infra.chat.ali.base-url=https://dashscope.aliyuncs.com
meowflow.infra.chat.ali.model=qwen-turbo

# --- 百度文心 -------------------------------------------------------------
meowflow.infra.chat.baidu.api-key=
meowflow.infra.chat.baidu.secret-key=
meowflow.infra.chat.baidu.model=ernie-4.0-8k-latest


# =============================================================================
# === Embedding Providers (缺失时 KnowledgeController 上传/检索失败)      ===
# =============================================================================
# KnowledgeService.uploadDocument() / SearchService.search() 都会调 EmbeddingClient

# --- OpenAI Embedding -----------------------------------------------------
embedding.openai.api-key=${OPENAI_API_KEY:}
embedding.openai.base-url=https://api.openai.com/v1
embedding.openai.model=text-embedding-3-small
embedding.openai.dimension=1536

# --- 阿里通义 Embedding ---------------------------------------------------
embedding.ali.api-key=${meowflow.infra.chat.ali.api-key:}
embedding.ali.base-url=https://dashscope.aliyuncs.com
embedding.ali.model=text-embedding-v2
embedding.ali.dimension=1536


# =============================================================================
# === 通知集成 (缺失时 IntegrationController 发送通知失败)               ===
# =============================================================================
# 这些不是环境变量，而是通过 Controller 注册到内存中的配置。
# 启动后用以下任一接口注入即可：
#   POST /api/infra/integration/configs/dingtalk   {"webhookUrl":"...","secret":"..."}
#   POST /api/infra/integration/configs/feishu     {"webhookUrl":"..."}
#   POST /api/infra/integration/configs/wxwork     {"webhookUrl":"..."}
#
# 钉钉 webhook 获取: 钉钉群 → 群设置 → 智能群助手 → 添加机器人 → 自定义 → 复制 webhook
# 加签 secret 在同一页面生成。
#
# 飞书 webhook 获取: 飞书群 → 设置 → 群机器人 → 添加机器人 → 自定义 webhook
# 企微 webhook 获取: 群机器人 → 添加 → 复制 webhook 地址


# =============================================================================
# === 可选：模型路由 (ChatClientFactory & LLM 节点执行会用)             ===
# =============================================================================
meowflow.ai.provider=openai
meowflow.ai.mock=false

meowflow.ai.openai.enabled=true
meowflow.ai.openai.api-key=${OPENAI_API_KEY:}
meowflow.ai.openai.base-url=https://api.openai.com/v1

meowflow.ai.anthropic.enabled=true
meowflow.ai.anthropic.api-key=${ANTHROPIC_API_KEY:}
meowflow.ai.anthropic.base-url=https://api.anthropic.com

meowflow.ai.router.primary=gpt-4o
meowflow.ai.router.fallback=gpt-4o-mini
meowflow.ai.router.fallback-models[0]=gpt-4o
meowflow.ai.router.fallback-models[1]=gpt-4o-mini
meowflow.ai.router.fallback-models[2]=claude-3-5-sonnet-20240620

meowflow.ai.circuit-breaker.enabled=true
meowflow.ai.circuit-breaker.failure-rate-threshold=50
meowflow.ai.circuit-breaker.wait-duration-in-open-state=30s
meowflow.ai.circuit-breaker.sliding-window-size=10
meowflow.ai.circuit-breaker.minimum-number-of-calls=5


# =============================================================================
# === MCP 工具 (缺失时 MCPToolController.executeTool 会找不到子进程)      ===
# =============================================================================
# MCP 工具不在环境变量中配置。
# 启动后注册:
#   POST /api/infra/mcp/tools
#   {
#     "name": "filesystem",
#     "description": "Read/write local files",
#     "provider": "mcp-filesystem",
#     "adapterType": "stdio",
#     "endpoint": "npx -y @modelcontextprotocol/server-filesystem /tmp"
#   }


# =============================================================================
# === Nacos 配置共享 (可选, 推荐用 docker 内 nacos)                     ===
# =============================================================================
# SPRING_CLOUD_NACOS_DISCOVERY_ENABLED=true
# SPRING_CLOUD_NACOS_CONFIG_ENABLED=true
# meowflow.config.nacos.server-addr=nacos:8848
# meowflow.config.nacos.namespace=meowflow-dev
# meowflow.config.nacos.group=DEFAULT_GROUP
