# 统一换行符，避免跨平台踩坑。
#
# 背景：仓库此前没有 .gitattributes。Windows 上 core.autocrlf=true 会把工作区
# 文件转成 CRLF，提交时本应转回 LF —— 但已入库的文件会保留 CRLF。
# 结果 deploy/docker/init-postgres.sh 以 CRLF 入库，在 Linux 容器里执行时
# 直接失败：
#   /docker-entrypoint-initdb.d/init-postgres.sh: /bin/bash^M: bad interpreter
# 导致 docker compose 部署时 PostgreSQL 初始化中断、容器以 126 退出。

# 默认：交由各平台处理，但入库统一 LF
* text=auto

# Shell 脚本必须 LF —— 它们在 Linux 容器 / bash 中执行，CRLF 会让 shebang 失效
*.sh            text eol=lf
*.bash          text eol=lf
Dockerfile      text eol=lf
*.dockerfile    text eol=lf

# Windows 脚本必须 CRLF —— cmd.exe 对 LF 的 .bat 处理不稳定
*.bat           text eol=crlf
*.cmd           text eol=crlf
*.ps1           text eol=crlf
*.psm1          text eol=crlf

# 配置 / 源码：入库统一 LF
*.yml           text eol=lf
*.yaml          text eol=lf
*.properties    text eol=lf
*.xml           text eol=lf
*.json          text eol=lf
*.md            text eol=lf
*.sql           text eol=lf
*.java          text eol=lf
*.ts            text eol=lf
*.vue           text eol=lf
*.js            text eol=lf

# 二进制：禁止任何换行符转换
*.png           binary
*.jpg           binary
*.jpeg          binary
*.gif           binary
*.ico           binary
*.svg           text eol=lf
*.jar           binary
*.war           binary
*.ez            binary
*.zip           binary
*.gz            binary
*.pdf           binary
*.woff          binary
*.woff2         binary
*.ttf           binary
*.eot           binary
